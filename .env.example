# Токен бота-наставника от @BotFather (ОТДЕЛЬНЫЙ бот, не «Лиза»)
TELEGRAM_BOT_TOKEN=

# Твой chat_id. Оставь пустым при первом запуске: напиши боту /start —
# он пришлёт chat_id. Впиши его сюда и перезапусти бота.
OWNER_CHAT_ID=

# ИИ (любой OpenAI-совместимый API). По умолчанию — DeepSeek.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# Голосовые сообщения → текст (OpenAI-совместимый Whisper). По умолчанию Groq
# (ключ: console.groq.com). Для OpenAI: STT_BASE_URL=https://api.openai.com/v1,
# STT_MODEL=whisper-1. Без ключа бот просто ответит, что голосовые не включены.
STT_API_KEY=
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3-turbo

# Часовой пояс (смещение от UTC). Екатеринбург = 5, Москва = 3.
TZ_OFFSET_HOURS=5

# Утренний план дня по входящим задачам.
PLAN_TIME=08:30

# Время совета по умолчанию для новых проектов и вечернего итога.
DEFAULT_TIME=09:00
EVENING_TIME=20:00

# SQLite-база (относительно корня проекта).
DB_PATH=data/mentor.db
