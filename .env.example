# ============================================================================
# AI Coding Agent — переменные окружения
# Скопируйте в .env и заполните. .env НЕ коммитится в git (см. .gitignore).
# Никогда не помещайте эти значения во frontend, логи или сообщения пользователю.
# ============================================================================

# --- DeepSeek (официальный API) --------------------------------------------
# Ключ получить в личном кабинете DeepSeek. Хранится ТОЛЬКО здесь.
DEEPSEEK_API_KEY=
# Base URL официального API (OpenAI-совместимый). Меняйте только при необходимости.
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Модель по умолчанию. Актуальные имена API: deepseek-flash, deepseek-v4-pro.
# В UI есть переключатель между ними (выбор сохраняется в БД).
DEEPSEEK_MODEL=deepseek-flash

# --- GitHub (Фаза 2) --------------------------------------------------------
# Fine-grained Personal Access Token с минимальными правами на нужные репозитории:
#   Contents: Read/Write, Pull requests: Read/Write, Checks/Commit statuses: Read.
# Оставьте пустым, если GitHub-интеграция не нужна.
GITHUB_TOKEN=

# --- Аутентификация (один администратор на первом этапе) -------------------
ADMIN_USER=admin
# bcrypt-хэш пароля. Сгенерировать:  python -m app.scripts.hash_password 'ваш-пароль'
# В базе/коде хранится ТОЛЬКО хэш, никогда не открытый пароль.
ADMIN_PASSWORD_HASH=

# Секрет для подписи сессионных cookie. Сгенерировать:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Поведение сессий / безопасность ----------------------------------------
# Время жизни сессии в секундах (по умолчанию 12 часов).
SESSION_MAX_AGE=43200
# Ставить Secure-флаг на cookie (ОБЯЗАТЕЛЬНО true за HTTPS в проде).
# Для локальной разработки по http можно временно false.
COOKIE_SECURE=true

# --- Пути ------------------------------------------------------------------
# Путь к SQLite-базе.
DATABASE_URL=sqlite:///./data/agent.db
# Путь к config.yaml (проекты, модель, тарифы). По умолчанию рядом с backend.
CONFIG_PATH=./config.yaml
# Директория для временных файлов сессий (загрузки, архивы).
WORKSPACE_TMP=./data/tmp
