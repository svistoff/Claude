# Telegram
# Токен бота, полученный от @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Telegram ID пользователя(ей), которым разрешено пользоваться ботом.
# Можно указать несколько через запятую: ALLOWED_USER_ID=123456789,987654321
# Узнать свой ID можно у @userinfobot
ALLOWED_USER_ID=123456789

# ID приватного канала-хранилища видео (бот должен быть в нём админом), вида -100...
TELEGRAM_STORAGE_CHANNEL_ID=-1001234567890

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Supabase — VPS ходит в supabase.co напрямую, посетители сайта из РФ — только
# через sb.ekb-guide.ru, поэтому все ссылки на медиа переписываются под MEDIA_BASE_URL
SUPABASE_URL=https://hbmdpqnseywphwgxsnlg.supabase.co
SUPABASE_SERVICE_KEY=                  # service_role — ТОЛЬКО на сервере, никогда в git!
MEDIA_BASE_URL=https://sb.ekb-guide.ru

# Видео-хранилище
VIDEO_PUBLIC_BASE=https://video.ekb-guide.ru
VIDEO_PROXY_PORT=8092
MAX_VIDEO_MB=20                        # ЖЁСТКИЙ лимит
EVENT_GRACE_DAYS=3                     # удалять видео через N дней после события
FALLBACK_TTL_DAYS=30                   # если дата события не распознана

# Ссылка на раздел «Предложенное» в админке афиши (для ответа боту после заявки)
ADMIN_URL=https://afisha.ekb-guide.ru/admin.html

# Прочее
ALBUM_WINDOW_SECONDS=3
MAX_CONCURRENT_SUBMISSIONS=3           # не более N заявок обрабатываются одновременно
TZ_OFFSET=+05:00                       # Екатеринбург, для разбора относительных дат
LOG_LEVEL=INFO
