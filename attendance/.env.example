# Ключ для подписи cookie-сессий веб-панели. Сгенерировать можно так:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-real-random-key

# Учётка администратора веб-панели, создаётся один раз при первом запуске
# (если таблица admin_users пуста). Дальше пароль можно сменить только
# напрямую в БД — смена пароля через UI не входит в MVP.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Путь к файлу SQLite
DB_PATH=data/attendance.db

# Сколько живёт сессия в браузере после входа (секунды). По умолчанию 12 часов.
SESSION_MAX_AGE_SECONDS=43200

LOG_LEVEL=INFO

# ---- Значения по умолчанию для первого запуска ----
# Дальше редактируются через веб-панель (/settings) без перезапуска —
# эти переменные читаются только если таблица app_settings ещё пустая.

# Интервал опроса роутера, секунды (ТЗ: 60)
POLL_INTERVAL=60

# Таймаут отсутствия для фиксации ухода, минуты (ТЗ: 20)
ABSENCE_TIMEOUT_MINUTES=20

# Через сколько часов отсутствия зарегистрированного телефона показывать
# подсказку "возможно, сменился MAC" (см. обсуждение рандомизации MAC)
LONG_ABSENCE_HINT_HOURS=3

# "fake" — тестовый адаптер без реального роутера (для разработки/демо).
# "xiaomi" — реальный Xiaomi AX3000T/RD23. Переключить на xiaomi нужно,
# когда появится доступ к роутеру — см. README, раздел
# "Когда появится доступ к роутеру".
ROUTER_ADAPTER=fake

ROUTER_BASE_URL=http://192.168.31.1
ROUTER_USERNAME=admin
ROUTER_PASSWORD=

TIMEZONE=Asia/Yekaterinburg
