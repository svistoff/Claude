# Токен бота, полученный от @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Telegram ID пользователя(ей), которым разрешено пользоваться ботом.
# Можно указать несколько через запятую: ALLOWED_USER_ID=123456789,987654321
# Узнать свой ID можно у @userinfobot
ALLOWED_USER_ID=123456789

# Канал "На выкладку", куда бот публикует результат.
# Либо числовой id вида -1001234567890 (бот должен быть админом канала),
# либо @username публичного канала
TARGET_CHANNEL_ID=-1001234567890

# Ключ OpenAI API
OPENAI_API_KEY=sk-...

# Модель для переписывания текста (по умолчанию gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Опционально: свой совместимый с OpenAI endpoint (прокси и т.п.)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Путь к файлу SQLite базы данных
DB_PATH=bot_data.db

# Защита от дублей: true/false. При включении бот предупреждает (но не блокирует)
# при повторной пересылке того же source_message_id/media_group_id от того же пользователя
DUPLICATE_PROTECTION=false

# Окно ожидания сбора альбома (в секундах) перед постановкой в очередь
ALBUM_WINDOW_SECONDS=1.5

# Максимум попыток обработки задания (AI + публикация) перед статусом ERROR
MAX_ATTEMPTS=3

# Интервал опроса очереди воркером, когда она пуста (в секундах)
POLL_INTERVAL_SECONDS=2

# Уровень логирования: DEBUG/INFO/WARNING/ERROR
LOG_LEVEL=INFO
