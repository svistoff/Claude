# Токен бота, полученный от @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Ключ OpenAI API
OPENAI_API_KEY=sk-...

# Модель для генерации ответов персонажа
OPENAI_MODEL=gpt-4o-mini

# Опционально: свой совместимый с OpenAI endpoint (прокси и т.п.)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Путь к файлу SQLite базы данных
DB_PATH=data/bot.db

# Сколько бесплатных сообщений в сутки даём пользователю
FREE_MESSAGES_PER_DAY=15

# Цена доната за продолжение общения сверх лимита, в Telegram Stars (XTR)
DONATE_STARS_PRICE=50

# Сколько дополнительных сообщений даёт один донат
DONATE_BONUS_MESSAGES=20

# Сколько последних сообщений диалога передавать AI как контекст
HISTORY_LIMIT=20

# Вероятность, что персонаж "занят" и ответит не сразу, а с задержкой (0.0-1.0)
BUSY_PROBABILITY=0.15

# Диапазон задержки отложенного ответа, в минутах
BUSY_DELAY_MIN_MINUTES=5
BUSY_DELAY_MAX_MINUTES=25

# Цена доната "ответить сейчас" (пропустить задержку "занятости"), в Stars
PRIORITY_REPLY_STARS_PRICE=30

# Как часто проверять, не пора ли доставить отложенный ответ, в секундах
PENDING_REPLY_POLL_SECONDS=20

# Через сколько новых сообщений обновлять долгосрочную память (сводку фактов)
MEMORY_SUMMARY_EVERY_N_MESSAGES=12

# Как часто проверять, не пора ли персонажу написать первой, в секундах
PROACTIVE_CHECK_INTERVAL_SECONDS=3600

# Персонаж пишет первой, если с последнего сообщения пользователя прошло
# от MIN до MAX часов (не слишком рано, не слишком поздно/бессмысленно)
PROACTIVE_MIN_HOURS_SINCE_LAST_MESSAGE=20
PROACTIVE_MAX_HOURS_SINCE_LAST_MESSAGE=72

# Вероятность, что подходящему пользователю действительно напишут первой (0.0-1.0)
PROACTIVE_PROBABILITY=0.5

# Уровень логирования: DEBUG/INFO/WARNING/ERROR
LOG_LEVEL=INFO
