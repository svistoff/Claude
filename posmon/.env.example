# ── Приложение ────────────────────────────────────────────────────────────
POSMON_ENV=production                 # production | development
POSMON_SECRET_KEY=change-me-to-a-long-random-string   # для подписи сессий
POSMON_BASE_URL=https://stat.xmassage.vip
POSMON_TIMEZONE=Asia/Yekaterinburg
LOG_LEVEL=INFO

# ── База данных ───────────────────────────────────────────────────────────
# Прод (PostgreSQL на том же VPS):
DATABASE_URL=postgresql+asyncpg://posmon:PASSWORD@127.0.0.1:5432/posmon
# Локально можно SQLite:
# DATABASE_URL=sqlite+aiosqlite:///./posmon.db

# ── Первичный админ (создаётся при инициализации, если пользователей нет) ──
POSMON_ADMIN_LOGIN=admin
POSMON_ADMIN_PASSWORD=change-me

# ── Сбор выдачи: регион и глубина ─────────────────────────────────────────
YANDEX_REGION_LR=54                   # 54 = Екатеринбург
DEFAULT_DEPTH=50                      # ТОП-N по умолчанию

# ── Yandex Search API (непесонализированные профили) ──────────────────────
# Получается в Yandex Cloud / AI Studio, услуга платная (постоплата за запросы).
YANDEX_API_FOLDER_ID=
YANDEX_API_KEY=
# Эндпоинт v2 (по умолчанию синхронный веб-поиск). Оставь пустым для значения по умолчанию.
YANDEX_API_ENDPOINT=

# ── Сервис распознавания капчи (браузерные профили) ───────────────────────
# 2captcha / rucaptcha / anti-captcha — совместимый API-ключ.
CAPTCHA_PROVIDER=                     # rucaptcha | anticaptcha | (пусто = выключено)
CAPTCHA_API_KEY=

# ── Браузерный сбор (персонализированные профили: Екатеринбуржец/Приезжий) ─
# Требует установленного Chromium: .venv/bin/playwright install chromium
BROWSER_HEADLESS=true                 # true на сервере без экрана
BROWSER_PROFILES_DIR=                 # где хранить профили браузера (пусто = posmon/browser_profiles)
BROWSER_NAV_TIMEOUT_MS=45000
BROWSER_PACE_MIN=15                   # пауза между выборками, сек (антибот)
BROWSER_PACE_MAX=40
BROWSER_SAVE_HTML=true                # сохранять HTML выдачи для аудита/подгонки парсера
BROWSER_SAVE_SCREENSHOT=false
BROWSER_ARTIFACTS_DIR=                # куда складывать HTML/скриншоты (пусто = posmon/artifacts)

# ── Прокси (опционально, задел на рост блокировок) ────────────────────────
BROWSER_PROXY=                        # напр. http://user:pass@host:port

# ── Планировщик и воркеры ─────────────────────────────────────────────────
DAILY_CHECK_ENABLED=true
DAILY_CHECK_TIME=02:00                # SEO-прогон, локальное время POSMON_TIMEZONE
DAILY_CHECK_JITTER_SECONDS=900        # случайное смещение старта (раздел 12 ТЗ)
BATTLE_CHECK_ENABLED=false            # дневной боевой прогон (браузер, с рекламой)
BATTLE_CHECK_TIME=19:00
WORKERS=3                             # параллелизм сбора
MAX_ATTEMPTS=3                        # retry при временной ошибке
