# Путь к файлу SQLite (создаётся автоматически при первом запуске)
DB_PATH=./data/randomgiveaway.db

HOST=127.0.0.1
PORT=8001
LOG_LEVEL=INFO

# Простая защита мутирующих ручек (создание/импорт/розыгрыш) без полноценной
# регистрации пользователей — см. §17 ТЗ. Если не задать, проверка отключена.
ADMIN_TOKEN=

# --- Этап 4 (живые источники) — не используются на Этапе 1 ---
# Скоуп сужен до собственных розыгрышей ekb_guide (не сторонних организаторов),
# подробности решения — в randomgiveaway/README.md и adapters/*.

# Long-lived access-токен собственного Business/Creator-аккаунта ekb_guide,
# полученный через Meta App в Development mode (без App Review). Требует
# периодического обновления (~60 дней) — фоновая задача, ещё не реализована.
INSTAGRAM_ACCESS_TOKEN=

# Токен сообщества ЕКБ ГИД для wall.getComments
VK_COMMUNITY_TOKEN=

# Сессия/токен для чтения группы обсуждений канала ekb_guide
TELEGRAM_SESSION=
