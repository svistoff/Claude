# Путь к файлу SQLite (создаётся автоматически при первом запуске)
DB_PATH=./data/randomgiveaway.db

HOST=127.0.0.1
PORT=8001
LOG_LEVEL=INFO

# Простая защита мутирующих ручек (создание/импорт/розыгрыш) без полноценной
# регистрации пользователей — см. §17 ТЗ. Если не задать, проверка отключена.
ADMIN_TOKEN=

# --- Живые источники ---
# Скоуп сужен до собственных розыгрышей ekb_guide (не сторонних организаторов),
# подробности решения — в randomgiveaway/README.md и adapters/*.

# --- Instagram (Instagram API with Instagram Login) ---
# App ID/Secret из Meta for Developers → мой app → Instagram → API setup.
# Нужны только для разовой авторизации через /api/instagram/oauth/start —
# после неё сюда автоматически запишется сам токен.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Должен буква-в-букву совпадать со строкой "Valid OAuth Redirect URIs" в
# настройках приложения.
INSTAGRAM_OAUTH_REDIRECT_URI=https://random.ekb-guide.ru/api/instagram/oauth/callback

# Заполняется автоматически при первом /api/instagram/oauth/start и далее
# при каждом продлении (randomgiveaway/scripts/refresh_instagram_token.py).
# Руками задавать не нужно.
INSTAGRAM_ACCESS_TOKEN=

# --- VK (пользовательский OAuth через VK ID, не токен сообщества — см.
# README). Приложение создаётся на id.vk.ru → "Сервис авторизации VK ID" →
# Standalone-приложение (НЕ dev.vk.com/apps — там создаются VK Mini Apps,
# для сервера не годятся).
# App ID из настроек VK ID-приложения. Секретный/сервисный ключ НЕ нужен —
# этот flow использует PKCE, client_secret в нём не участвует.
VK_APP_ID=
# Должен буква-в-букву совпадать с "Доверенным Redirect URL" в настройках
# VK ID-приложения.
VK_OAUTH_REDIRECT_URI=https://random.ekb-guide.ru/api/vk/oauth/callback

# Заполняются автоматически при /api/vk/oauth/start и далее при каждом
# продлении (randomgiveaway/scripts/refresh_vk_token.py). Руками задавать не
# нужно. Токен VK ID короткоживущий (в отличие от старого scope=offline) —
# без cron-продления по VK_REFRESH_TOKEN перестанет работать.
VK_ACCESS_TOKEN=
VK_REFRESH_TOKEN=
VK_DEVICE_ID=

# --- Telegram (бот с кнопкой "Участвую" + реферальные ссылки — не чтение
# истории комментариев, Bot API её не отдаёт; см. README.md, «Подключение
# Telegram»). Бот отдельный от bot/ (тот занят AI-рерайтом контента, не
# розыгрышами) — заводится отдельно через @BotFather.
# Токен бота (от @BotFather). Бот должен быть админом канала ниже с правом
# публикации постов.
TELEGRAM_BOT_TOKEN=
# Канал, куда публикуются посты розыгрышей и где проверяется подписка —
# например "@ekb_guide".
TELEGRAM_CHANNEL=
# Секрет для проверки заголовка X-Telegram-Bot-Api-Secret-Token на
# /api/telegram/webhook — придумать самостоятельно (любая случайная строка),
# указать этот же секрет при регистрации вебхука (см. README.md).
TELEGRAM_WEBHOOK_SECRET=
# Потолок засчитываемых приглашений на одного участника (антифрод).
TELEGRAM_MAX_REFERRALS=15

# Устарело: заготовка под чтение истории через MTProto-сессию — сейчас не
# используется (см. randomgiveaway/config.py).
TELEGRAM_SESSION=
